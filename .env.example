# AGENT-11 Website Environment Variables
# Copy this file to .env.local for local development

# GitHub API Configuration
# Optional: GitHub Personal Access Token for higher rate limits (5000/hour vs 60/hour)
# Generate at: https://github.com/settings/tokens (no scopes needed for public repos)
GITHUB_TOKEN=your_github_token_here

# Next.js Configuration
# Disable telemetry in production
NEXT_TELEMETRY_DISABLED=1

# Environment
NODE_ENV=production

# API Configuration
# Base URL for API calls (used for CORS and caching)
NEXT_PUBLIC_API_BASE_URL=https://www.agent-11.com

# Repository Configuration (optional overrides)
# These are used as defaults in the GitHub API service
GITHUB_OWNER=TheWayWithin
GITHUB_REPO=agent-11-website

# Production Build Optimization
# Remove console logs in production
NEXT_PUBLIC_PRODUCTION=true